            { "className": "org.joget.apps.form.lib.TextField", "properties": { "id": "s_uniformity", "label": "Uniformity", "value": "", "validator": { "className": "org.joget.apps.form.lib.DefaultValidator", "properties": { "mandatory": "false", "type": "numeric", "message": "" } } } },
            { "className": "org.joget.apps.form.lib.TextField", "properties": { "id": "s_cleancup", "label": "Clean Cup", "value": "", "validator": { "className": "org.joget.apps.form.lib.DefaultValidator", "properties": { "mandatory": "false", "type": "numeric", "message": "" } } } },
