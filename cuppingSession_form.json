            { "className": "org.joget.plugin.enterprise.CalculationField", "properties": { "id": "total_score", "label": "Total Cupping Score (/100)", "style": "us", "numOfDecimal": "2", "storeNumeric": "true", "variables": [ { "variableName": "a", "fieldId": "s_aroma", "operation": "sum" }, { "variableName": "b", "fieldId": "s_flavor", "operation": "sum" }, { "variableName": "c", "fieldId": "s_aftertaste", "operation": "sum" }, { "variableName": "d", "fieldId": "s_acidity", "operation": "sum" }, { "variableName": "e", "fieldId": "s_body", "operation": "sum" }, { "variableName": "f", "fieldId": "s_balance", "operation": "sum" }, { "variableName": "g", "fieldId": "s_uniformity", "operation": "sum" }, { "variableName": "h", "fieldId": "s_cleancup", "operation": "sum" }, { "variableName": "i", "fieldId": "s_sweetness", "operation": "sum" }, { "variableName": "j", "fieldId": "s_overall", "operation": "sum" }, { "variableName": "k", "fieldId": "defects", "operation": "sum" } ], "equation": "a + b + c + d + e + f + g + h + i + j - k" } },
